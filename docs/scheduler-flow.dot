/**
 * Lane Scheduler — operational flow diagram
 *
 * Render with:
 *   dot -Tsvg docs/scheduler-flow.dot -o docs/scheduler-flow.svg
 *   dot -Tpng -Gdpi=150 docs/scheduler-flow.dot -o docs/scheduler-flow.png
 *
 * The orange / bold path traces one pod (CSE310 · rgarcia · gpu-medium)
 * from creation through admission to execution.
 */

digraph lane_scheduler {

    rankdir = TB
    compound = true
    nodesep  = 0.5
    ranksep  = 0.7

    node [fontname="Helvetica" fontsize=10 margin="0.18,0.10"]
    edge [fontname="Helvetica" fontsize=9]

    // ─────────────────────────────────────────────────────────────
    // Colour palette
    //   pending job    : #fffde7  (light amber)
    //   journey pod    : #ffe0b2  (light orange)   edges: #bf360c bold
    //   running pod    : #e3f2fd  (light blue)
    //   journey running: #ffe0b2  (orange, same as pending)
    //   node bg        : #f1f8e9  (light green)
    //   queue bg       : #e8eaf6  (light indigo)
    //   cycle bg       : #fff8f0
    // ─────────────────────────────────────────────────────────────

    // ═════════════════════════════════════════════════════════════
    // 1 · KUBERNETES — SCHEDULINGGATED PODS
    //     An external mutating admission controller has injected
    //     schedulingGates: [{name: "lane-scheduler"}] and the
    //     gpu-class label onto every pod before it reaches us.
    // ═════════════════════════════════════════════════════════════

    subgraph cluster_pending {
        label     = "Kubernetes API — SchedulingGated Pods\n(spec.schedulingGates: [{name: \"lane-scheduler\"}])"
        style     = dashed
        color     = gray60
        fontcolor = gray40
        fontsize  = 11

        node [shape=note]

        p_cse250  [label="CSE250\nkwong · gpu-small"
                   style=filled fillcolor="#fffde7"]

        p_cse310  [label="★ CSE310\nrgarcia · gpu-medium"
                   style=filled fillcolor="#ffe0b2" penwidth=2.5 color="#bf360c"]

        p_cse234  [label="CSE234\npatel · gpu-large"
                   style=filled fillcolor="#fffde7"]

        // invisible rank-enforcing spine
        p_cse250 -> p_cse310 -> p_cse234 [style=invis]
    }


    // ═════════════════════════════════════════════════════════════
    // 2 · POD WATCH THREAD
    // ═════════════════════════════════════════════════════════════

    watch [label="Pod Watch Thread\ndetects pods whose schedulingGate = lane-scheduler\ntranslates pod → Job domain object\nsubmits to per-lane queue"
           shape=rectangle style="filled,rounded"
           fillcolor="#f5f5f5" penwidth=1.5
           width=3.8]

    p_cse250 -> watch [style=dashed color=gray60]
    p_cse310 -> watch [color="#bf360c" penwidth=2.5
                       label="  ① pod detected\n  (SchedulingGated)"]
    p_cse234 -> watch [style=dashed color=gray60]


    // ═════════════════════════════════════════════════════════════
    // 3 · PER-LANE PRIORITY QUEUES
    // ═════════════════════════════════════════════════════════════

    subgraph cluster_queues {
        label    = "Per-Lane Priority Queues  (inside LaneSchedulerController)"
        style    = filled
        fillcolor = "#e8eaf6"
        fontsize  = 11
        color    = "#7986cb"

        subgraph cluster_q_gs {
            label     = "gpu-small lane"
            style     = filled
            fillcolor = white

            q_gs [shape=record style=filled fillcolor="#fffde7"
                  label="{ CSE250 | 3 pending | W = 0.27 }\
                       |{ CSE310 | 1 pending | W = 0.77 }"]
        }

        subgraph cluster_q_gm {
            label     = "gpu-medium lane"
            style     = filled
            fillcolor = "#fff8f0"

            q_gm [shape=record style=filled fillcolor="#ffe0b2"
                  penwidth=2.5 color="#bf360c"
                  label="{ ★ CSE310 · rgarcia | rank \#1 | W = 0.77 }\
                       |{   CSE250           | rank \#2 | W = 0.27 }"]
        }

        subgraph cluster_q_gl {
            label     = "gpu-large lane"
            style     = filled
            fillcolor = white

            q_gl [shape=record style=filled fillcolor="#fffde7"
                  label="{ CSE234 | 2 pending | W = 0.77 }"]
        }
    }

    watch -> q_gs  [style=dashed color=gray60]
    watch -> q_gm  [color="#bf360c" penwidth=2.5
                    label="  ② enqueued as Job\n  in gpu-medium lane"]
    watch -> q_gl  [style=dashed color=gray60]


    // ═════════════════════════════════════════════════════════════
    // 4 · SCHEDULING CYCLE
    // ═════════════════════════════════════════════════════════════

    subgraph cluster_cycle {
        label     = "Scheduler.cycle()  —  runs every 10 s"
        style     = filled
        fillcolor = "#fff8f0"
        fontsize  = 11
        color     = "#fb8c00"

        scorer [label="Priority Scorer\nP = W × Mode × Age / U\n\
─────────────────────────────\n\
CSE310: 0.77 × 1.0 × 1.4 / 0.10 ≈ 10.8  ← top\n\
CSE250: 0.27 × 1.0 × 1.1 / 0.60 ≈  0.5\n\
(scores all jobs across all lanes)"
                shape=box style="filled,rounded" fillcolor=white
                width=4]

        capgate [label="Capacity Gate\n\
free = lane_cap − running_units − admitted_units\n\
gpu-medium: 6 − 5 − 0 = 1 unit free  ✓\n\
(pod requires 1 GPU unit → admitted)"
                 shape=diamond style=filled fillcolor=white
                 width=4.5]

        admit [label="_admit_pod()\n\
PATCH pod spec:\n\
  nodeSelector:   {gpu-class: medium}\n\
  tolerations:    [{key: gpu-class\n\
                    value: medium\n\
                    effect: NoSchedule}]\n\
  schedulingGates: [{$patch: delete\n\
                     name: lane-scheduler}]"
               shape=box style="filled,rounded" fillcolor=white
               width=3.8]

        scorer -> capgate [color="#bf360c" penwidth=2.5
                           label="  ④ capacity\n  check"]
        capgate -> admit  [color="#bf360c" penwidth=2.5
                           label="  ⑤ pass →\n  admit pod"]
    }

    q_gm  -> scorer [color="#bf360c" penwidth=2.5
                     label="  ③ scored in\n  cycle"]
    q_gs  -> scorer [style=dashed color=gray60
                     lhead=cluster_cycle]
    q_gl  -> scorer [style=dashed color=gray60]


    // ═════════════════════════════════════════════════════════════
    // 5 · CLUSTER NODES
    //     GPU nodes carry gpu-class=<class>:NoSchedule taints.
    //     The admission patch adds the matching toleration so the
    //     default Kubernetes scheduler can place the pod.
    // ═════════════════════════════════════════════════════════════

    subgraph cluster_nodes {
        label     = "Cluster Nodes"
        style     = filled
        fillcolor = "#f1f8e9"
        fontsize  = 11
        color     = "#558b2f"

        subgraph cluster_n_gs {
            label     = "GPU-Small Nodes  (×2 · 4 GPU each)\ntaint: gpu-class=small:NoSchedule"
            style     = filled
            fillcolor = white

            n_gs [shape=record style=filled fillcolor="#e3f2fd"
                  label="{ CSE250 · dtanaka     | 1 GPU   | RUNNING }\
                       |{ CSE310 · epham       | 1 GPU   | RUNNING }\
                       |{ CSE250 · mhernandez  | 2 GPU   | RUNNING }\
                       |{ (remaining capacity) |         |         }"]
        }

        subgraph cluster_n_gm {
            label     = "GPU-Medium Nodes  (×3 · 2 GPU each)\ntaint: gpu-class=medium:NoSchedule"
            style     = filled
            fillcolor = "#fff8f0"

            n_gm [shape=record style=filled fillcolor="#e3f2fd"
                  penwidth=2.5 color="#bf360c"
                  label="{ CSE310 · fwilson  | 2 GPU | RUNNING }\
                       |{ CSE250 · gliu     | 1 GPU | RUNNING }\
                       |{ ★ CSE310 · rgarcia | 1 GPU | RUNNING  ← journey pod }"]
        }
    }

    admit -> n_gm [color="#bf360c" penwidth=2.5
                   label="  ⑥ gate removed +\n  nodeSelector + toleration\n  patched; k8s default\n  scheduler places pod"]

    // Dashed feedback: running pods feed back into the capacity gate
    n_gm -> capgate [style=dashed color=gray50 dir=back constraint=false
                     label="running units\nreported each cycle"]
    n_gs -> capgate [style=dashed color=gray50 dir=back constraint=false]


    // ═════════════════════════════════════════════════════════════
    // Legend
    // ═════════════════════════════════════════════════════════════

    subgraph cluster_legend {
        label     = "Legend"
        style     = filled
        fillcolor = white
        color     = gray70
        fontsize  = 10

        leg_journey [label="★  Journey pod (CSE310 · rgarcia)"
                     shape=note style=filled fillcolor="#ffe0b2"
                     color="#bf360c" penwidth=2]

        leg_pending  [label="Other SchedulingGated pod"
                      shape=note style=filled fillcolor="#fffde7"]

        leg_running  [label="Running pod on node"
                      shape=box  style=filled fillcolor="#e3f2fd"]

        leg_journey -> leg_pending -> leg_running [style=invis]
    }
}
